<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <radialGradient id="bg-glow-s" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stopColor="#141418" />
      <stop offset="100%" stopColor="#08080a" />
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg-glow-s)" />

  <!-- Stacked Deck Center -->
  <g transform="translate(600, 330) scale(0.95)">
    <!-- Deep bottom shadow -->
    <ellipse cx="0" cy="245" rx="190" ry="24" fill="#000" opacity="0.8" filter="blur(16px)" />
    
    <!-- Stack thickness edge layers -->
    <rect x="-135" y="-195" width="270" height="420" rx="14" fill="#beb19b" stroke="#38332c" stroke-width="1.5" />
    <rect x="-137" y="-198" width="274" height="420" rx="14" fill="#cbbfab" stroke="#38332c" stroke-width="1.5" />
    <rect x="-139" y="-202" width="278" height="420" rx="14" fill="#d8cdb8" stroke="#38332c" stroke-width="1.5" />
    <rect x="-140" y="-206" width="280" height="420" rx="14" fill="#e5dbc7" stroke="#38332c" stroke-width="1.5" />

    <!-- Top Card: Ace of Spades (E) -->
    <g transform="translate(0, -10)">
      <rect x="-140" y="-210" width="280" height="424" rx="14" fill="#ede6d8" stroke="#332e27" stroke-width="2" />
      <!-- Borders -->
      <rect x="-130" y="-200" width="260" height="404" rx="10" fill="none" stroke="#292524" stroke-width="1" opacity="0.4" />

      <!-- Letter E -->
      <text x="-115" y="-160" font-family="'Playfair Display', Georgia, serif" font-size="34" font-weight="900" fill="#18181b">E</text>
      <!-- Spade under E -->
      <path d="M-105,-140 C-103,-136 -97,-132 -97,-127 C-97,-123 -101,-120 -105,-120 C-109,-120 -113,-123 -113,-127 C-113,-132 -107,-136 -105,-140 Z M-107,-121 L-108,-116 L-102,-116 L-103,-121 Z" fill="#18181b" />

      <!-- Hypercube top right -->
      <g transform="translate(65, -150) scale(0.65)" stroke="#18181b" stroke-width="1.5" fill="none">
        <rect x="-24" y="-24" width="48" height="48" rx="2" />
        <rect x="-12" y="-12" width="24" height="24" rx="1" />
        <line x1="-24" y1="-24" x2="-12" y2="-12" />
        <line x1="24" y1="-24" x2="12" y2="-12" />
        <line x1="24" y1="24" x2="12" y2="12" />
        <line x1="-24" y1="24" x2="-12" y2="12" />
      </g>

      <!-- Center Ornate Ace of Spades -->
      <g transform="translate(0, 10) scale(1.6)">
        <path d="M0,-24 C5,-16 18,-8 18,5 C18,13 10,18 0,18 C-10,18 -18,13 -18,5 C-18,-8 -5,-16 0,-24 Z" fill="#18181b" />
        <path d="M-3,14 L-6,26 L6,26 L3,14 Z" fill="#18181b" />
      </g>

      <!-- Bragg lattice bottom left -->
      <g transform="translate(-60, 130) scale(0.65)" stroke="#18181b" stroke-width="1.2" fill="none">
        <line x1="-30" y1="-10" x2="30" y2="-10" />
        <line x1="-30" y1="10" x2="30" y2="10" />
        <circle cx="-20" cy="-10" r="2" fill="#18181b" />
        <circle cx="0" cy="-10" r="2" fill="#18181b" />
        <circle cx="20" cy="-10" r="2" fill="#18181b" />
        <circle cx="-20" cy="10" r="2" fill="#18181b" />
        <circle cx="0" cy="10" r="2" fill="#18181b" />
        <circle cx="20" cy="10" r="2" fill="#18181b" />
      </g>

      <!-- Inverted A bottom right -->
      <g transform="rotate(180) translate(-105, -190)">
        <text font-family="'Playfair Display', Georgia, serif" font-size="34" font-weight="900" fill="#18181b">A</text>
      </g>
    </g>
  </g>
</svg>
